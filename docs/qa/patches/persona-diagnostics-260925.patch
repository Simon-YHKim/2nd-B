+type RoleGenerationStage = "read" | "build" | "synthesize" | "persist";
+type RoleGenerationClassification = "authentication" | "permission" | "rate_limit" |
+  "service_unavailable" | "database" | "network" | "unknown";
+
+// Keep diagnostic metadata only. Provider/DB errors can contain private input,
+// response bodies, or credentials, so never retain their message or cause.
+export class RoleGenerationError extends Error {
+  readonly httpStatus: number | null;
+  readonly classification: RoleGenerationClassification;
+
+  constructor(readonly stage: RoleGenerationStage, original: unknown) {
+    super("Persona role generation failed");
+    this.name = "RoleGenerationError";
+    const source = original && typeof original === "object"
+      ? original as { status?: unknown; context?: unknown; code?: unknown; name?: unknown }
+      : {};
+    const context = source.context && typeof source.context === "object"
+      ? source.context as { status?: unknown } : {};
+    const status = source.status ?? context.status;
+    this.httpStatus = typeof status === "number" && Number.isInteger(status) && status >= 400 && status <= 599
+      ? status : null;
+    if (this.httpStatus === 401 || source.code === "PGRST301") this.classification = "authentication";
+    else if (this.httpStatus === 403 || source.code === "42501") this.classification = "permission";
+    else if (this.httpStatus === 429) this.classification = "rate_limit";
+    else if (this.httpStatus !== null && this.httpStatus >= 500) this.classification = "service_unavailable";
+    else if (source.code === "42P01" || source.code === "42703" || source.code === "PGRST202" || source.code === "PGRST204") {
+      this.classification = "database";
+    } else if (source.name === "FunctionsFetchError") this.classification = "network";
+    else this.classification = "unknown";
+  }
 }
 
