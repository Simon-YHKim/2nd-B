+// Never singleTop/singleTask and never applicationContext: API 26-28 cache a
+// mutable FingerprintManager in ContextImpl. Each request needs a new cache.
+class DeviceAuthenticationActivity : Activity() {
+  private var request: DeviceAuthenticationRequests.Request? = null
+  private var session: DeviceBiometricSession? = null
+  private var credentialPending = false
+  private var closing = false
+  private var started = false
+  private var status: TextView? = null
+  private val mainHandler = Handler(Looper.getMainLooper())
+  private val executor = Executor { runnable -> mainHandler.post(runnable); Unit }
+
+  override fun onCreate(savedInstanceState: Bundle?) {
+    super.onCreate(savedInstanceState)
+    window.addFlags(WindowManager.LayoutParams.FLAG_SECURE)
+    val call = DeviceAuthenticationRequests.attach(
+      intent?.getStringExtra(DeviceAuthenticationRequests.REQUEST_ID), this
+    )
+    request = call
+    if (call == null) {
+      finish()
+      return
+    }
+    // Recreation is a canceled request, never an implicit new authentication.
+    if (savedInstanceState != null || !DeviceAuthenticationRequests.isPending(call)) {
+      complete("app_cancel")
+      closeAuthentication()
+      return
+    }
+    showLockContent(call.options)
+  }
+
+  override fun onResume() {
+    super.onResume()
+    if (!started && pending()) {
+      started = true
+      startBiometric()
+    }
+  }
+
+  override fun onStop() {
+    // Before Q the platform does not own this lifecycle cancellation. Keep a
+    // PIN child alive, but never leave a background fingerprint scan active.
+    if (Build.VERSION.SDK_INT < 29 && !credentialPending && !closing) complete("app_cancel")
+    super.onStop()
+  }
+
+  private fun showLockContent(options: AuthOptions) {
+    val content = LinearLayout(this).apply {
+      orientation = LinearLayout.VERTICAL
+      gravity = Gravity.CENTER
+      setBackgroundColor(android.graphics.Color.BLACK)
+      val inset = (24 * resources.displayMetrics.density).toInt()
+      setPadding(inset, inset, inset, inset)
+    }
+    status = TextView(this).apply {
+      text = options.promptMessage
+      setTextColor(android.graphics.Color.WHITE)
+      gravity = Gravity.CENTER
+      textSize = 20f
+    }
+    content.addView(status)
+    if (!options.disableDeviceFallback) {
+      content.addView(Button(this).apply {
+        text = options.cancelLabel ?: options.promptMessage
+        setOnClickListener { startCredential() }
+      })
+    }
+    content.addView(Button(this).apply {
+      setText(android.R.string.cancel)
+      setOnClickListener { complete("user_cancel") }
+    })
+    setContentView(content)
+  }
+
+  private fun pending(): Boolean = !closing && request?.let {
+    DeviceAuthenticationRequests.isPending(it)
+  } == true
+
+  private fun startBiometric() {
+    val call = request ?: return
+    try {
+      if (!(getSystemService(KEYGUARD_SERVICE) as KeyguardManager).isDeviceSecure) {
+        complete("not_enrolled")
+        return
+      }
+      session = if (Build.VERSION.SDK_INT >= 28) {
+        PlatformBiometricSession(this, call, executor)
+      } else {
+        FingerprintSession(this)
+      }
+      session?.start()
+    } catch (_: Exception) {
+      biometricError(1)
+    }
+  }
+
+  internal fun biometricSucceeded() {
+    if (!credentialPending && pending()) complete(null)
+  }
+
+  internal fun biometricError(code: Int) {
+    if (!pending() || credentialPending) return
