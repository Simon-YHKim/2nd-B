+}
+
+@RequiresApi(28)
+private class PlatformBiometricSession(
+  private val host: DeviceAuthenticationActivity,
+  private val request: DeviceAuthenticationRequests.Request,
+  private val executor: Executor
+) : DeviceBiometricSession {
+  private val signal = CancellationSignal()
+  private var canceled = false
+  private var crypto: RequestCrypto? = null
+
+  override fun start() {
+    val options = request.options
+    val builder = BiometricPrompt.Builder(host).setTitle(options.promptMessage)
+    options.promptSubtitle?.let { builder.setSubtitle(it) }
+    options.promptDescription?.let { builder.setDescription(it) }
+    if (Build.VERSION.SDK_INT >= 29) builder.setConfirmationRequired(options.requireConfirmation)
+    if (Build.VERSION.SDK_INT >= 30) {
+      var allowed = if (options.biometricsSecurityLevel == BiometricsSecurityLevel.STRONG) 15 else 255
+      if (!options.disableDeviceFallback) allowed = allowed or 32768
+      builder.setAllowedAuthenticators(allowed)
+    }
+    if (Build.VERSION.SDK_INT < 30 || options.disableDeviceFallback) {
+      builder.setNegativeButton(options.cancelLabel ?: host.getString(android.R.string.cancel), executor) { _, _ ->
+        if (!canceled) {
+          if (options.disableDeviceFallback) host.biometricError(13) else host.startCredential()
+        }
+      }
+    }
+    val prompt = builder.build() // Never reused for a different request.
+    val callback = object : BiometricPrompt.AuthenticationCallback() {
+      override fun onAuthenticationSucceeded(result: BiometricPrompt.AuthenticationResult) {
+        if (canceled) return
+        val proof = crypto
+        if (proof != null && !proof.verify(result.cryptoObject?.cipher)) {
+          host.biometricError(2)
+          return
+        }
+        host.biometricSucceeded()
+      }
+      override fun onAuthenticationError(code: Int, message: CharSequence) {
+        if (!canceled) host.biometricError(code)
+      }
+      override fun onAuthenticationHelp(code: Int, message: CharSequence) {
+        if (!canceled) host.biometricHelp(message)
+      }
+    }
+    if (Build.VERSION.SDK_INT == 29 && options.biometricsSecurityLevel == BiometricsSecurityLevel.STRONG) {
+      // API 29 has no setAllowedAuthenticators(STRONG), and rejects combining
+      // crypto with deviceCredentialAllowed. Strong proof then separate PIN.
+      val proof = RequestCrypto(request.id)
+      crypto = proof
+      prompt.authenticate(BiometricPrompt.CryptoObject(proof.prepare()), signal, executor, callback)
+    } else {
+      prompt.authenticate(signal, executor, callback)
+    }
+  }
+
+  override fun cancel() {
+    canceled = true
+    try {
+      signal.cancel()
+    } finally {
+      crypto?.close()
+      crypto = null
+    }
+  }
+}
+
+private class RequestCrypto(requestId: String) {
+  private val alias = "expo.device-auth.request.$requestId"
+  private var cipher: Cipher? = null
+  private val store = KeyStore.getInstance("AndroidKeyStore").apply { load(null) }
+
+  fun prepare(): Cipher {
+    // Remove only this module's orphaned per-request keys after process death.
+    // There is one active host; no live request's key can be deleted here.
+    val aliases = store.aliases()
+    while (aliases.hasMoreElements()) {
+      val oldAlias = aliases.nextElement()
+      if (oldAlias.startsWith("expo.device-auth.request.")) store.deleteEntry(oldAlias)
+    }
+    // No request shares an alias/operation, including canceled requests.
+    val generator = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, "AndroidKeyStore")
+    generator.init(KeyGenParameterSpec.Builder(alias, KeyProperties.PURPOSE_ENCRYPT)
+      .setBlockModes(KeyProperties.BLOCK_MODE_CBC)
+      .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_PKCS7)
+      .setUserAuthenticationRequired(true)
+      .setUserAuthenticationValidityDurationSeconds(-1)
+      .build())
+    generator.generateKey()
+    val key = store.getKey(alias, null) as SecretKey
+    return Cipher.getInstance("AES/CBC/PKCS7Padding").apply {
+      init(Cipher.ENCRYPT_MODE, key)
+      cipher = this
+    }
+  }
+
+  fun verify(returned: Cipher?): Boolean {
+    val expected = cipher ?: return false
+    if (returned !== expected) return false
+    return try {
+      expected.doFinal(ByteArray(16).also { SecureRandom().nextBytes(it) })
+      true
+    } catch (_: Exception) {
+      false
+    } finally {
+      close()
+    }
+  }
+
+  fun close() {
+    cipher = null
+    runCatching { store.deleteEntry(alias) }
+  }
+}
