+package expo.modules.localauthentication
+
+import android.app.Activity
+import android.content.Intent
+import android.os.Bundle
+import android.os.Looper
+import expo.modules.kotlin.Promise
+import java.lang.ref.WeakReference
+import java.util.UUID
+
+internal fun authenticationResponse(error: String? = null) = Bundle().apply {
+  putBoolean("success", error == null)
+  error?.let { putString("error", it) }
+}
+
+// Main-thread-only registry. Neither Activity results nor callbacks look up a
+// replacement promise. A request owns one Activity for its entire lifetime.
+internal object DeviceAuthenticationRequests {
+  const val REQUEST_ID = "expo.modules.localauthentication.requestId"
+
+  class Request(val owner: Any, val options: AuthOptions, val promise: Promise) {
+    val id: String = UUID.randomUUID().toString()
+    var host: WeakReference<DeviceAuthenticationActivity>? = null
+    var result: Bundle? = null
+    val cancellations = mutableListOf<Promise>()
+  }
+
+  private var active: Request? = null
+
+  private fun onMainThread() = check(Looper.myLooper() == Looper.getMainLooper())
+
+  fun launch(activity: Activity, owner: Any, options: AuthOptions, promise: Promise) {
+    onMainThread()
+    if (active != null) {
+      promise.resolve(authenticationResponse("app_cancel"))
+      return
+    }
+    val request = Request(owner, options, promise)
+    active = request
+    try {
+      activity.startActivity(Intent(activity, DeviceAuthenticationActivity::class.java).apply {
+        putExtra(REQUEST_ID, request.id)
+      })
+    } catch (_: Exception) {
+      request.result = authenticationResponse("not_available")
+      close(request)
+    }
+  }
+
+  fun attach(id: String?, host: DeviceAuthenticationActivity): Request? {
+    onMainThread()
+    val request = active ?: return null
+    if (request.id != id || request.host != null) return null
+    // A cancel before onCreate keeps the slot until this exact host is closed.
+    request.host = WeakReference(host)
+    return request
+  }
+
+  fun isPending(request: Request): Boolean {
+    onMainThread()
+    return active === request && request.result == null
+  }
+
+  fun finish(request: Request, host: DeviceAuthenticationActivity, error: String?) {
+    onMainThread()
+    if (!isPending(request) || request.host?.get() !== host) return
+    request.result = authenticationResponse(error)
+    host.closeAuthentication()
+  }
+
+  fun cancel(owner: Any, completion: Promise? = null) {
+    onMainThread()
+    val request = active
+    if (request == null || request.owner !== owner) {
+      completion?.resolve()
+      return
+    }
+    completion?.let { request.cancellations.add(it) }
+    // Revocation may override a success whose host has not finished yet.
+    request.result = authenticationResponse("app_cancel")
+    request.host?.get()?.closeAuthentication()
+  }
+
+  fun destroyed(request: Request, host: DeviceAuthenticationActivity) {
+    onMainThread()
+    if (active !== request || request.host?.get() !== host) return
+    if (request.result == null) request.result = authenticationResponse("app_cancel")
+    close(request)
+  }
+
+  private fun close(request: Request) {
+    if (active !== request) return
+    active = null
+    // Resolve only after host destruction, or when launching it failed. This is
+    // a lifecycle acknowledgement, not a timer or a guessed callback drain.
+    runCatching { request.promise.resolve(request.result ?: authenticationResponse("app_cancel")) }
+    request.cancellations.forEach { runCatching { it.resolve() } }
+    request.cancellations.clear()
+    request.host = null
+  }
+}
