+        7, 9 -> "lockout"
+        1, 11, 12, 14 -> "not_available"
+        3 -> "timeout"
+        else -> "authentication_failed"
+      })
+    }
+  }
+
+  internal fun biometricHelp(message: CharSequence?) {
+    if (pending() && !credentialPending && !message.isNullOrBlank()) status?.text = message
+  }
+
+  internal fun startCredential() {
+    val call = request ?: return
+    if (!pending() || credentialPending) return
+    if (call.options.disableDeviceFallback) {
+      complete("user_cancel")
+      return
+    }
+    // Set phase before cancellation: its error callback belongs to the old
+    // biometric phase and must not finish/replace this credential request.
+    credentialPending = true
+    runCatching { session?.cancel() }
+    session = null
+    try {
+      val keyguard = getSystemService(KEYGUARD_SERVICE) as KeyguardManager
