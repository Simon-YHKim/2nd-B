+      complete("not_available")
+    }
+  }
+
+  override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
+    super.onActivityResult(requestCode, resultCode, data)
+    if (requestCode != CREDENTIAL_RESULT || !credentialPending || !pending()) return
+    credentialPending = false
+    complete(if (resultCode == RESULT_OK) null else "user_cancel")
+  }
+
+  override fun onBackPressed() { complete("user_cancel") }
+
+  private fun complete(error: String?) {
+    request?.let { DeviceAuthenticationRequests.finish(it, this, error) }
+  }
+
+  internal fun closeAuthentication() {
+    if (closing) return
+    closing = true
+    runCatching { session?.cancel() }
+    session = null
+    if (credentialPending) {
+      runCatching { finishActivity(CREDENTIAL_RESULT) }
+    }
+    finish()
+  }
+
+  override fun onDestroy() {
+    closing = true
+    runCatching { session?.cancel() }
+    session = null
+    if (credentialPending) runCatching { finishActivity(CREDENTIAL_RESULT) }
