+
+private interface DeviceBiometricSession {
+  fun start()
+  fun cancel()
+}
+
+private class FingerprintSession(private val host: DeviceAuthenticationActivity) : DeviceBiometricSession {
+  private val signal = CancellationSignal()
+  private var canceled = false
+
+  override fun start() {
