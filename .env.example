# 2nd-Brain — environment template
# Copy to .env and fill in. NEVER commit .env.

# === Supabase (C3/C4/C5/C6/C8/C10) ===
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# === Gemini / Vertex AI (C1/C2) ===
# Set USE_VERTEX=true and provide GOOGLE_CLOUD_PROJECT to satisfy C2.
# When USE_VERTEX=false, falls back to Google AI Studio API key (dev only).
EXPO_PUBLIC_USE_VERTEX=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_KEY=

# === LLM routing (D-26, docs/LLM-ROUTING.md) ===
# Phase gate for purpose-keyed vendor routing.
#   1 (or unset) = Phase 1: 100% Gemini backbone (XPRIZE-safe, $0/mo default)
#   2            = Phase 2: Anthropic/OpenAI seats activate for their purposes.
#                  Requires ANTHROPIC_API_KEY / OPENAI_API_KEY set as Supabase
#                  Edge Function secrets and claude-proxy / openai-proxy
#                  deployed. Client never holds vendor keys (C1).
EXPO_PUBLIC_LLM_PHASE=1
# EXPO_PUBLIC_LLM_VENDOR — backbone switch for the reasoning seats (advisor,
#   persona, gap, self-model, northstar, axis, ops, ...). One env, no code edit:
#     gemini      → all seats on Gemini (default posture, $0)
#     openai      → all seats on openai-proxy (needs OPENAI_API_KEY + deploy + credit)
#     claude      → all seats on claude-proxy (needs ANTHROPIC_API_KEY + credit)
#     perPurpose  → per-seat PHASE2_VENDOR map
#     unset       → back-compat (Phase-1 = Gemini, Phase-2 = the map)
#   OCR/voice/image pins and the classification backbone always stay Gemini.
#   Chat is NOT governed by this switch -- see EXPO_PUBLIC_CHAT_VENDOR below.
#   Rollback to $0 anytime: EXPO_PUBLIC_LLM_VENDOR=gemini.
# EXPO_PUBLIC_LLM_VENDOR=gemini

# EXPO_PUBLIC_CHAT_VENDOR — vendor for 세컨비 대화 (secondb_chat) ONLY.
#     gemini / unset → gemini-proxy (the behaviour shipped to date)
#     openai         → openai-proxy   ← Simon's 2026-08-18 direction
#     claude         → claude-proxy
#
#   Chat has its own knob because the seat switch above only applies at
#   EXPO_PUBLIC_LLM_PHASE=2, and production runs Phase 1. Moving chat via Phase 2
#   would switch nine other surfaces at the same moment. One purpose, one
#   variable: flip it to move chat, unset it to put chat back. No code edit.
#
#   ⚠ DEPLOY BEFORE YOU FLIP. openai-proxy rejects unseated purposes with
#   400 purpose_not_seated before doing anything else. The secondb_chat seat
#   exists in the repo but only takes effect once the function is redeployed:
#     supabase functions deploy openai-proxy --project-ref zoacryukmdeivmolvyhj
#   Setting this variable first makes every chat message fail.
# EXPO_PUBLIC_CHAT_VENDOR=openai

# === Observability (Sprint 1) ===
EXPO_PUBLIC_SENTRY_DSN=
# Web usage analytics (public client ids, not secrets). Both no-op until set,
# and only load after the user enables "External analytics" in privacy settings.
# GA4: the "G-XXXXXXX" Measurement ID. Clarity: the project id from clarity.microsoft.com.
EXPO_PUBLIC_GA4_MEASUREMENT_ID=
EXPO_PUBLIC_CLARITY_PROJECT_ID=

# === Rewarded ads (AdMob + server-side verification) ===
# Fail closed unless SSV and the current platform's full ID are set.
# Server REWARD_SSV_AD_UNIT_IDS is a comma-separated allowlist (at most two).
# It accepts full IDs or numeric suffixes; the ticket and signed callback
# use the numeric suffix. Deploy the server contract before client activation.
EXPO_PUBLIC_REWARD_SSV=
# Full ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN IDs, never Google test units.
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID_IOS=
# Deprecated Android-only fallback, used only if _ANDROID is absent.
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=

# === Testing / QA: subscription paywall override ===
# Override client-side subscription UI for QA. Server subscription and usage
# limits remain authoritative; this does not grant a paid server entitlement.
#   off    = restore real per-user billing gating (DEFAULT, launch/release)
#   brain  = show Brain UI for testing (server limits still apply)
#   soma | cortex | free = pin everyone to that tier to test a paywall boundary
EXPO_PUBLIC_FORCE_TIER=off

# Paddle (Merchant of Record) web checkout. All public: a client-side token is
# publishable like the Supabase anon key, and price ids are catalog identifiers.
# The notification secret is NOT here - it lives in Supabase edge secrets.
# Unset = checkout stays closed (paddleCheckoutAvailable() is false).
EXPO_PUBLIC_PADDLE_CLIENT_TOKEN=
# production (default) or sandbox. Sandbox also requires its own Supabase project.
# Match token prefix live_/test_ and that environment's prices; no URL override.
EXPO_PUBLIC_PADDLE_ENVIRONMENT=production
EXPO_PUBLIC_PADDLE_PRICE_CORTEX_MONTHLY=
EXPO_PUBLIC_PADDLE_PRICE_CORTEX_YEARLY=
EXPO_PUBLIC_PADDLE_PRICE_BRAIN_MONTHLY=
EXPO_PUBLIC_PADDLE_PRICE_BRAIN_YEARLY=

# Server-only settings: configure in the matching Supabase project's Edge secrets.
# Never expose these as EXPO_PUBLIC_ values. An unset environment preserves production.
# PADDLE_ENVIRONMENT=production
# Sandbox requires both URLs and rejects sandbox == live or a different SUPABASE_URL.
# PADDLE_SANDBOX_SUPABASE_URL=https://sandbox-project.supabase.co
# PADDLE_LIVE_SUPABASE_URL=https://live-project.supabase.co
# Keep Paddle API/webhook/binding secrets and price IDs separate in each project.
