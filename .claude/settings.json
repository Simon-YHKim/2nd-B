{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 60,
            "statusMessage": "Syncing SimonK Stack..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$HOME/.claude/skills/context-guardian/scripts/install-rules.sh\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "context-guardian: 가드 규칙 적용"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/refresh-shared-checkout.sh\" 2>&1 || true",
            "timeout": 60,
            "statusMessage": "공용 체크아웃 최신화 (ff-only)"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Skill"
    ]
  }
}
