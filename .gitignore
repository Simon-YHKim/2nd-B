# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
# ...and as a symlink. Worktrees share the canonical install by symlinking
# node_modules (CLAUDE.md "Worktrees & branches"), and a symlink is a FILE to
# git, so the trailing-slash pattern above does not match it. Without this line
# every worktree shows an untracked `node_modules`, and one `git add -A` commits
# a symlink pointing at an absolute local path.
node_modules

# git worktrees nest INSIDE this repo at .worktrees/<branch> (team rule: all
# 2ndB worktrees live here, never as sibling folders or under Coding Infra).
# Each is a full working tree with its own .git file — never commit them.
.worktrees/

# context-guardian (per-session state, not committed)
SESSION_RECOVERY.md
context_limit_log.json
.claudeignore

# Local QA / emulator artifacts (screenshots, logs, working punch lists)
reports/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Private keys that arrive as .txt, which the *.key and *.pem patterns do not
# catch. The age backup decryption key sat at the repo root as
# 2ndB_backup_age_PRIVATE_KEY_260811.txt, untracked but NOT ignored. This repo
# is public, so one stray "git add -A" would have published the key that
# decrypts every database backup. The canonical copy belongs in a password
# manager, outside any checkout.
*PRIVATE_KEY*

# EAS local-credentials manifest (carries the p12 password) + restored signing
# files; written only on the ephemeral CI runner. /ios below already covers
# ios/certs, listed explicitly for defense in depth.
credentials.json
ios/certs/

# Firebase per-app config (project ids/keys) - provision locally or via the
# EAS file env var GOOGLE_SERVICES_JSON; never commit
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*
.codex-run/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.local
.env*.local

# typescript
*.tsbuildinfo

# jest / coverage
coverage/

# tsx cache
.tsx

# Claude Code per-user settings (project-level shared settings.json stays tracked)
.claude/settings.local.json
.claude/local/

# generated native folders
/ios
/android
.gstack/

# Local-only dev artifacts (never commit)
.claude/launch.json
.tmp_hq_pack/

# stray env backups (never commit)
.env.bak
.env.*.bak
.env.local

# root probe scripts dropped by concurrent agents (never commit)
test_*.js
.codex-*.md
.ag-*.md

# stray hub paths accidentally written by AI worktrees (belong in C:/Coding/AI Infra/Communication)
/agents/

# IDE / agent-local dirs (never commit)
.idea/
.codex/

# local asset staging (generated art + pixy skill clone — canonical assets live in assets/images etc.)
assets/generated/
assets/pixy/

# iOS build artifacts (bloat prevention)
ios-sim-build.tar.gz
eas-build.log
*.tar.gz

# QA verify scratch logs (per-run, regenerated by `npm run verify`, never commit)
.verify-*
.verify-*.out

# extracted iOS simulator build bundle (tarball already ignored above; 145MB, cloud-built)
ios-sim-extract/

# scratch landing-page experiment (promote to its own repo if kept; never commit into the app tree)
landing-clone/

# agent/report output dir — APKs, web exports, QA artifacts; regenerable, 300MB+ locally.
# never commit (a stray `git add -A` must not sweep it into the app tree).
Output/

# root thought-dump / synthesis docs — belong in the wiki or Output/, not the live app tree.
2ndb-thought-organization-synthesis.html
260617생각정리.txt

# proto_rev2 local-only audit captures (79MB, kept out of git)
design/proto_rev2/docs/improve-audit/

# Firebase config files - never commit (wired via EAS file env / GH secret)
**/google-services.json
**/GoogleService-Info.plist

# Apple / Firebase credential bundle — never commit (private keys, certs, CSRs,
# issuer IDs, provisioning profiles). Directory-level ignore so any future cert
# type is covered even if a specific extension isn't listed above. A stray
# `git add -A` must never sweep these into this PUBLIC repo.
fb_2ndb_K/
apl_sign.txt
.playwright-mcp/

# 앱 캡처 산출물(design/pixel_clay_260825/tools/capture-app.mjs). 레퍼런스와 달리
# 커밋하지 않는다 — 매 실행마다 새로 뜨고, 계정 상태에 따라 달라진다.
.app-shots/

# 세션 간 우편함(콘솔 ↔ CLI). 로컬 전용 — 커밋하지 않는다.
# 커밋하면 docs/HANDOFF.md 와 똑같은 문제로 돌아간다: 두 세션이 같은 파일을
# 서로 다른 브랜치에서 고쳐 머지에서 충돌한다. 안 커밋하는 것이 설계다.
# 규칙은 _sync/README.md.
_sync/

# Supabase CLI writes its link state here (project-ref, pooler-url, *-version).
# Local per-machine state, never meant for git — it showed up as 7 untracked
# files in the shared checkout on 2026-08-30 and confused the cleanup.
supabase/.temp/
